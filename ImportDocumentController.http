Content-Type: application/json

{
  "branchId": {{branchId}},
  "businessDate": "2026-07-28T10:00:00Z",
  "accountId": {{accountId}},
  "details": [
    {
      "bInventoryId": 1,
      "quantity": 10,
      "unitPrice": 20000
    }
  ],
  "partners": [
    {
      "partnerId": 1,
      "amountDue": 200000,
      "amountPaid": 300000
    }
  ]
}

