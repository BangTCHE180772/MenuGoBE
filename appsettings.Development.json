{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PayOS": {
    "ClientId": "YOUR_PAYOS_CLIENT_ID",
    "ApiKey": "YOUR_PAYOS_API_KEY",
    "ChecksumKey": "YOUR_PAYOS_CHECKSUM_KEY"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=YOUR_USERNAME;Password=YOUR_PASSWORD;SSL Mode=Prefer;Trust Server Certificate=true;Maximum Pool Size=100;Max Auto Prepare=0;Pooling=false;"
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_AT_LEAST_32_CHARACTERS",
    "Issuer": "MenuGoBackend",
    "Audience": "MenuGoFrontend"
  },
  "CloudinarySettings": {
    "CloudName": "YOUR_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
  },
  "MailSettings": {
    "Mail": "your_email@gmail.com",
    "DisplayName": "MenuGo System",
    "Password": "YOUR_GMAIL_APP_PASSWORD",
    "Host": "smtp.gmail.com",
    "Port": 587
  },
  "PointSystem": {
    "EarnRate_SpendAmount": 100000,
    "EarnRate_PointReward": 1000,
    "MinPointsToUse": 50000,
    "MaxDiscountPercentage": 50
  }
}